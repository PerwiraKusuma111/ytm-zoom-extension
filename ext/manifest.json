{
  "manifest_version": 3,
  "name": "Site Mobile Zoom",
  "version": "2.1.1",
  "description": "Atur zoom per-website (simpan terpisah tiap situs), Desktop UA per-situs, dan kunci anti pinch/double-tap zoom",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Mobile Zoom",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
